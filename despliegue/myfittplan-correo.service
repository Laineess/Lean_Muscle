[Unit]
Description=Envía los avisos encolados por correo
After=network-online.target mysql.service
Requires=mysql.service

[Service]
Type=oneshot
User=myfittplan
Group=myfittplan
WorkingDirectory=/opt/myfittplan
EnvironmentFile=/etc/myfittplan/config.env
ExecStart=/opt/myfittplan/.venv/bin/python -m app.trabajos.emisor_avisos

# El envío va con espaciado entre correos, así que un lote de 40 tarda alrededor de un
# minuto. El tope da margen sin dejar el proceso colgado si el SMTP no responde.
TimeoutStartSec=600

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/myfittplan
