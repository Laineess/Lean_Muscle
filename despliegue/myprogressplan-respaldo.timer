[Unit]
Description=Respaldo diario de MyProgressPlan

[Timer]
# 03:30, cuando no hay nadie capturando chequeos. La aleatoriedad evita que el respaldo
# coincida siempre con el de otros servidores del mismo proveedor y sature su red.
OnCalendar=*-*-* 03:30:00
RandomizedDelaySec=15min

# Si el servidor estaba apagado a esa hora, se ejecuta al encender. Un respaldo saltado sin
# aviso es exactamente el que falta el día del incidente.
Persistent=true

[Install]
WantedBy=timers.target
