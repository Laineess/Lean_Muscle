[Unit]
Description=Borra las imagenes vencidas (fotos de comida y de chequeo)
After=network-online.target mysql.service
Requires=mysql.service

[Service]
Type=oneshot
User=myprogressplan
Group=myprogressplan
WorkingDirectory=/opt/myprogressplan
EnvironmentFile=/etc/myprogressplan/config.env
ExecStart=/opt/myprogressplan/.venv/bin/python -m app.trabajos.purga

TimeoutStartSec=300

# Este proceso borra archivos del volumen de datos: necesita escritura ahi y nada mas.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/myprogressplan
