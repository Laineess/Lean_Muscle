# Plantilla de configuración. Copiar a `.env` en local; en el VPS vive en
# /etc/myprogressplan/config.env con permisos 600 y dueño root:myprogressplan.
#
# Ningún valor real va en este archivo: es lo único de la configuración que sí se versiona.

LM_ENTORNO=local                     # local | pruebas | produccion

# --- Base de datos ---
LM_BD_URL=mysql+pymysql://root:CAMBIAR@127.0.0.1:3306/leanmuscle?charset=utf8mb4

# --- Sesión ---
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(64))"
LM_SECRETO_SESION=CAMBIAR-ESTE-VALOR
LM_SESION_HORAS=720

# --- Almacenamiento de archivos sensibles ---
# Fuera de la raíz web. nginx lo sirve desde una `location internal;` y nunca directamente.
LM_RUTA_DATOS=./datos
LM_NGINX_PREFIJO_INTERNO=/protegido

LM_ZONA_HORARIA=America/Mexico_City

# --- Correo ---
# La contraseña es de aplicación, nunca la del correo. Con dominio propio: SPF, DKIM y DMARC.
LM_SMTP_HOST=smtp.gmail.com
LM_SMTP_PUERTO=587
LM_SMTP_USUARIO=
LM_SMTP_CONTRASENA_APP=
LM_SMTP_REMITENTE=MyProgressPlan <no-reply@myprogressplan.com>

# --- Notificaciones push (VAPID) ---
# Generar el par una sola vez:
#   python -c "from py_vapid import Vapid01; v=Vapid01(); v.generate_keys(); print(v.public_key, v.private_key)"
# Sin estas llaves el interruptor de notificaciones lo dice en claro en lugar de fingir
# que funciona.
LM_VAPID_PUBLICA=
LM_VAPID_PRIVADA=
LM_VAPID_CONTACTO=mailto:soporte@myprogressplan.com

# --- Reglas con interruptor ---
# Conservar la foto de línea base exige consentimiento aparte de la alumna.
LM_CONSERVAR_FOTO_LINEA_BASE=false
LM_RETENCION_FOTOS_MESES=4
