# Fin de línea.
#
# Los scripts de despliegue y las unidades de systemd **tienen que ir en LF**. Un `.sh` con
# CRLF falla en Ubuntu con `bad interpreter: /usr/bin/env bash^M`, que es un error que no
# dice lo que pasa y cuesta media hora encontrar.

* text=auto eol=lf

*.sh          text eol=lf
*.service     text eol=lf
*.timer       text eol=lf
*.conf        text eol=lf
config.env.example text eol=lf

*.png         binary
*.xlsm        binary
*.docx        binary
*.pdf         binary
