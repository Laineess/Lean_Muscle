# --- Secretos ---
# `.env` incluido: lleva la contraseña de la base, el secreto de sesión, la contraseña de
# aplicación del correo y la llave privada VAPID.
.env
config.env
*.env
!config.env.example

# --- Datos de las alumnas ---
# Fotografías de chequeo y comprobantes de pago. Nunca, bajo ninguna circunstancia.
/datos/

# --- Frontend ---
node_modules/
web/dist/
*.tsbuildinfo

# --- Material de la clienta ---
# Su hoja de cálculo real, con su método completo. No hace falta en el repositorio: está
# traducida celda por celda en `app/dominio/calculadora.py`, con pruebas que la verifican.
Calculadora del Fitness.xlsm
*.xlsm

# --- Logs de servidor ---
# Llevan IP de clientes e ids de usuario: no deben versionarse ni llegar al repositorio.
/logs/

# --- Volcados con datos ---
# Generados por `herramientas/volcar_datos.py` para verlos en el editor. Llevan datos reales
# (hashes de contrasena, nombres de alumnas): no deben versionarse ni llegar al VPS.
/volcado_datos.sql

# --- Sistema ---
.DS_Store
Thumbs.db
